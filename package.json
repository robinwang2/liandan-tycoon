{
  "name": "liandan-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#english-catalogs": { "browser": "./src/i18n/catalog.browser.js", "default": "./src/i18n/catalog.node.js" }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node tools/tables/export.mjs && vite build && node tools/pack.mjs",
    "sim": "node tools/sim.mjs",
    "check": "node tools/validate.mjs",
    "build:classic": "vite build classic && node tools/pack.mjs classic",
    "tables": "node tools/tables/export.mjs && node tools/validate.mjs",
    "tables:check": "node tools/tables/export.mjs --check",
    "parity": "node tools/parity.mjs check",
    "i18n": "node tools/i18n/check.mjs",
    "i18n:parity": "node tools/i18n/parity.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "saxes": "^5.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
